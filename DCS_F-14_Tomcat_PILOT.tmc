// PILOT file for DCS_F-14_Tomcat  by Astro
// TARGET version 3.0.25.127
// version 3.0, Sep 2026




// ------------------------------ PILOT BUTTON DEFINITIONS ----------------------------------------

int dcs_f14_pilot_button_definitions()																					// In separate function to reload after Jester switch
{

	// Target Management Switch / Armament Selector (overwrites common)
	TMS_fwd 	= CHAIN( DOWN+R_SHIFT, D(10), PULSE+'w', D(), UP+R_SHIFT );												// Weapon Selector up
	TMS_aft 	= CHAIN( DOWN+R_CTL, D(10), PULSE+'w', D(), UP+R_CTL ); 												// Weapon Selector down
	TMS_right 	= CHAIN( DOWN+R_ALT, D(10), PULSE+'w', D(), UP+R_ALT ); 												// Weapon Selector press
	TMS_left 	= 0;																									// 

	// Display Management Switch (overwrites common)
	DMS_fwd 	= TEMPO( CHAIN( DOWN+L_ALT+R_SHIFT, D(10), PULSE+'v', D(), UP+L_ALT+R_SHIFT ),							// VDI Mode Toggle
						 displaymode_prev, 500 );																		// [long] Display mode previous
	DMS_aft 	= TEMPO( CHAIN( DOWN+L_ALT+R_SHIFT, D(10), PULSE+'h', D(), UP+L_ALT+R_SHIFT ),							// HSD Mode Toggle
						 displaymode_whdn, 500 );																		// [long] Display mode WHDN (cruise/land)
	DMS_right 	= TEMPO( JSTR_rwr_unknown_norm,																			// [JSTR] RWR Unknown/NORM toggle
						 EXEC( "index_stcmd = (index_stcmd+1)%5;"														// [long] Steer CMD next
							   "ActKey( KEYON+PULSE+X(steercmdlist, index_stcmd) );" ), 500 );							// 		
	DMS_left 	= TEMPO( JSTR_rwr_ai_norm,																				// [JSTR] RWR AI/NORM toggle
						 EXEC( "index_stcmd = (index_stcmd+4)%5;"														// [long] Steer CMD previous
							   "ActKey( KEYON+PULSE+X(steercmdlist, index_stcmd) );" ),	500 );							// 		

	// Buttons (overwrite common)
	SC_short	= plm;																									// PLM button


}	// end dcs_f14_pilot_button_definitions()	===================================================




// ---------------------------------- F-14 PILOT CONTROLS -----------------------------------------

int dcs_f14_pilot_controls()
{

	// -------------------- COMMON CONTROLS -------------------------
					
	dcs_f14_pilot_button_definitions();					// load button definitions used by COMMON
	dcs_fighter_common_controls();						// load dcs COMMON controls
	dcs_fighter_common_mfd();							// load dcs MFD controls
														// before aircraft controls, to allow for overwriting of common controls when necessary


	// ---------------------- FLIGHT STICK --------------------------

	// -- DCS_Fighter_Common ---------
	// TG - Gun Trigger
	// S2 - Weapon Release Button
	// S1 - Nosewheel Steering Button
	// H1 - Trim Switch
	// H2 - Target Management Switch
	// JOYX
	// JOYY
	// -------------------------------


	// JSTR layer
	// Expand FOV Button - S3
	MapKey(&AVA_F16, S3,  		EXEC( "dcs_f14_jester_controls();" ));													// Switch to JESTER controls
	MapKeyR(&AVA_F16, S3,  		EXEC( "dcs_fighter_common_switch();" 													// Switch back to COMMON,
								  	  "dcs_f14_pilot_controls_switch();" ));											//   and PILOT controls



	// Countermeasure Management Switch
	// H4U	
	MapKeyIO(&AVA_F16, H4U, 	tgtdes_vsl_hi,																			// I - Target designate up / VSL HI
							 	dlcthumb_fwd );																			// O - DLC Thumbwheel Forward
	// H4D
	MapKeyIO(&AVA_F16, H4D, 	tgtdes_vsl_lo, 																			// I - Target designate down / VSL LO
							 	dlcthumb_aft );																			// O - DLC Thumbwheel Aft
	// H4R
	MapKeyIO(&AVA_F16, H4R, 	pal, 																					// I - Target designate fwd / PAL
			  				 	TEMPO( 0,																				// O - 
									   horns_right, 500	));																//	   [long] Throw horns right
	// H4L
	MapKeyIO(&AVA_F16, H4L, 	0, 																						// I - 
			  				 	TEMPO( 0,																				// O - 
									   horns_left, 500	));																//	   [long] Throw horns left
	// H4P
	MapKeyIO(&AVA_F16, H4P, 	0, 																						// I - 
							 	cm_dispense ); 																			// O - DLC Toggle / Countermeasure Dispense

	
	
 
	// -------------------- THROTTLE --------------------------------

	// --DCS_Fighter_Common---------
	// Left Throttle Button
	// SPDF/B
	// CHF/B
	// MSU/D/P
	// PSF/B
	// EACON/OFF Landing Gear
	// EOLIGN/OVER
	// EORIGN/OVER
	// EFLNORM/OVER
	// EFRNORM/OVER
	// SC
	// APUON/OFF
	// RDRNRM/DIS Canopy
	// IDLELON/IDLERON
	// THR_LEFT
	// THR_RIGHT
	// THR_FC
	// SCX
	// SCY
	// -----------------------------



	// Autopilot
	// APENG	
	MapKeyIO(&Throttle, APENG, 	autothrottle,																			// Toggle Auto Throttle
								autopilot );																			// Autopilot on/off
	// APDIS
	MapKey(&Throttle, APDIS, 	0 ); 																					// see autopilot_mode()
	// APPAT
	MapKey(&Throttle, APPAT, 	0 );																					// see autopilot_mode()
	// APAH
	MapKey(&Throttle, APAH, 	0 );																					// see autopilot_mode()
	// APALT
	MapKey(&Throttle, APALT, 	0 );																					// see autopilot_mode()



	// Pinky Switch (exterior lighting)
	// PSF
	MapKeyIO(&Throttle, PSF, 	CHAIN( extlight_posdim, D(),		 													// I - extlight_posdim
									   LED(&Throttle, LED_ONOFF, LED_CURRENT+LED4) ), 									//     LED4 ON
							 	CHAIN( extlight_full, D(), 																// O - extlight_full
									   LED(&Throttle, LED_ONOFF, LED_CURRENT+LED4) )); 									//     LED4 ON
	MapKeyRIO(&Throttle, PSF, 	CHAIN( 0, D(), 																			// I - 
									   LED(&Throttle, LED_ONOFF, LED_CURRENT-LED4) ),									//     LED4 OFF
							  	CHAIN( extlight_formation, D(), 														// O - extlight_formation
									   LED(&Throttle, LED_ONOFF, LED_CURRENT-LED4) )); 									//     LED4 OFF
	// PSB		
	MapKeyIO(&Throttle, PSB, 	CHAIN( 0, D(), 																			// I - 
									   LED(&Throttle, LED_ONOFF, LED_CURRENT+LED4) ), 									//     LED4 ON
							 	CHAIN( extlight_covert, D(), 															// O - extlight_covert
									   LED(&Throttle, LED_ONOFF, LED_CURRENT+LED4) )); 									//     LED4 ON
	MapKeyRIO(&Throttle, PSB, 	CHAIN( 0, D(), 																			// I - 
									   LED(&Throttle, LED_ONOFF, LED_CURRENT-LED4) ),									//     LED4 OFF
							  	CHAIN( extlight_formation, D(), 														// O - extlight_formation
									   LED(&Throttle, LED_ONOFF, LED_CURRENT-LED4) )); 									//     LED4 OFF


	// Flaps Switch
	// FLAPU
	MapKey(&Throttle, FLAPU,  	CHAIN( DOWN+L_SHIFT, D(10), PULSE+'f', D(), UP+L_SHIFT ));								// Flap Switch - UP
	// FLAPM
	MapKey(&Throttle, FLAPM, 	0 );																					// 
	// FLAPD	
	MapKey(&Throttle, FLAPD,  	PULSE+'f' );																			// Flap Switch - DOWN

	
	// Engine Operation
	// EOLIGN
	MapKeyIO(&Throttle, EOLIGN,	engine_ignition_left,																	// I - Crank Left Engine
								throttle_left_idle );																	// O - Throttle Left - IDLE

	// EORIGN
	MapKeyIO(&Throttle, EORIGN, engine_ignition_right,																	// I - Crank Right Engine
								throttle_right_idle );																	// O - Throttle Right - IDLE


								
	// U LAYER - [O] Air-to-Air Mode
	//			 [I] ACM Mode
	// BSF - LED1 ON/OFF
	MapKeyIO(&Throttle, BSF, 	CHAIN( displaymode_a2a, D(200),															// I - Display mode air to air
									   acmcover_open, D(),																//	   ACM cover open
									   LED(&Throttle, LED_ONOFF, LED_CURRENT+LED1) ), 									// 	   LED1 ON for U layer
								CHAIN( displaymode_a2a, D(200),															// O - Display mode air to air
									   LED(&Throttle, LED_ONOFF, LED_CURRENT+LED1) )); 									// 	   LED1 ON for U layer
	MapKeyRIO(&Throttle, BSF, 	CHAIN( acmcover_close, D(200),															// I - ACM cover close
									   displaymode_cruise, D(200),														// 	   Display mode cruise
									   LED(&Throttle, LED_ONOFF, LED_CURRENT-LED1) ), 									// 	   LED1 OFF for U layer 
								CHAIN( displaymode_cruise, D(200),														// O - Display mode cruise
									   LED(&Throttle, LED_ONOFF, LED_CURRENT-LED1) )); 									// 	   LED1 OFF for U layer

	// M LAYER - Navigation Mode
	// BSM - LED2 ON/OFF
	MapKey(&Throttle, BSM, 		LED(&Throttle, LED_ONOFF, LED_CURRENT+LED2)); 											// LED2 ON for M layer
	MapKeyR(&Throttle, BSM, 	LED(&Throttle, LED_ONOFF, LED_CURRENT-LED2)); 											// LED2 OFF for M layer

	// D LAYER - Air-to-Ground Mode
	// BSB - LED3 ON/OFF
	MapKeyIO(&Throttle, BSB, 	CHAIN( EXEC( "Throttle[BSB] = 0; DefEventHandler(EV_HID_INPUT_DATA, &Throttle, BSB);"),	// I - Temporary virtual M layer (reset D layer)
									   EXEC( "CAR_mode = 1;"															// 	   Set CAR_mode ON
											 "printf(\"CAR_mode = 1\\xa\");" ),											// 
									   LED(&Throttle, LED_ONOFF, LED_CURRENT+LED5) ),									//     LED5 ON
								CHAIN( displaymode_a2g, D(100),															// O - Display mode air to ground
									   EXEC( "if((index_stpt_aa)%3 == 2) index_stpt_ag = 4;"							// 	   Set correct steerpoint in A-G mode (element 0 is first element in list)
											 "else index_stpt_ag = (index_stpt_aa)%3;" ),								// 
									   LED(&Throttle, LED_ONOFF, LED_CURRENT+LED3) )); 									//     A-G mode on, LED3 ON for D layer
	MapKeyRIO(&Throttle, BSB, 	CHAIN( EXEC( "CAR_mode = 0;"															// I - Set CAR_mode OFF
											 "printf(\"CAR_mode = 0\\xa\");" ),											// 
									   LED(&Throttle, LED_ONOFF, LED_CURRENT-LED5) ),									//     LED5 OFF
								CHAIN( displaymode_cruise, D(),															// O - Display mode cruise
									   EXEC( "if((index_stpt_ag)%5 > 1) index_stpt_aa = 2;"								// 	   Set correct steerpoint in A-A mode (IP and ST default to WP3, element 0 is first element in list)
											 "else index_stpt_aa = (index_stpt_ag)%5;" ),								//
									   LED(&Throttle, LED_ONOFF, LED_CURRENT-LED3) ));									// 	   A-G mode off, LED3 OFF for D layer

	

	// ---------------------------- MFD -----------------------------

	// Brightness and Contrast control VDI screen
	MapKeyIO(&LMFD, CONU, 		CHAIN( R_WIN+R_SHIFT, D(10), 'i' ), 													// I - Right MFD CON Up
								CHAIN( R_WIN+L_SHIFT, D(10), 'i' ));													// O - VDI Screen Contrast Inc (Slow)

	MapKeyIO(&LMFD, COND, 		CHAIN( R_WIN+R_SHIFT, D(10), 'j' ), 													// I - Right MFD CON Down
								CHAIN( R_WIN+L_SHIFT, D(10), 'j' ));													// O - VDI Screen Contrast Dec (Slow)

	MapKeyIO(&LMFD, BRTU, 		CHAIN( R_WIN+R_SHIFT, D(10), 'u' ), 													// I - Right MFD BRT Up
								CHAIN( R_WIN+L_SHIFT, D(10), 'u' ));													// O - VDI Screen Brightness Knob Inc (Slow)

	MapKeyIO(&LMFD, BRTD, 		CHAIN( R_WIN+R_SHIFT, D(10), 'h' ), 													// I - Right MFD BRT Down
								CHAIN( R_WIN+L_SHIFT, D(10), 'h' ));													// O - VDI Screen Brightness Knob Dec (Slow)

	


	// ---------- Also load SWITCH part of PILOT controls -----------
	
	dcs_f14_pilot_controls_switch();																					// controls to be switched back after JESTER use


}	// ====  end dcs_f14_pilot_controls()  ========================================================




// -----------------  PILOT SWITCH CONTROLS to be switched back after JESTER use ------------------

int dcs_f14_pilot_controls_switch()
{

	// -------------------- COMMON SWITCH CONTROLS ------------------

	dcs_f14_pilot_button_definitions();						// load button definitions used by COMMON
	dcs_fighter_common_switch();							// switch back to common controls


	// ------------------ AIRCRAFT SWITCH CONTROLS ------------------

	// Coolie Switch
	// CSU
	MapKeyIOUMD(&Throttle, CSU, 0,																						// IU - 
								0, 																						// OU - 
								seat_down,																  				// IM - Seat Adjustment Down
								EXEC( "if (WHDN_mode) ActKey( PULSE+KEYON+nw_strut_retract );" ),						// OM - [WHDN] Nose strut kneel
								0,																						// ID - 
								0 ); 																					// OD - 
	// CSD
	MapKeyIOUMD(&Throttle, CSD, 0,																	 					// IU - 
								missilemode_toggle,																		// OU - Missile Mode Toggle (boresight/slave)
								seat_up,																  				// IM - Seat Adjustment Up
								EXEC( "if (WHDN_mode) ActKey( PULSE+KEYON+nw_strut_extend );" ),						// OM - [WHDN] Nose strut extend
								wingsweep_bomb,														 					// ID - Wing Sweep Bomb Mode
								0 );																 					// OD - 
	// CSR
	MapKeyIOUMD(&Throttle, CSR, TEMPO( 0,																				// IU - 
									   wingsweep_aft, 500 ),															// 		[long] Wing Sweep Aft
								uncage,																					// OU - CAGE-SEAM button
								TEMPO( bombing_tool,																	// IM - Bombing Tool
									   wingsweep_aft, 500 ),															// 		[long] Wing Sweep Aft
								EXEC( "if (WHDN_mode) ActKey( PULSE+KEYON+L_SHIFT+R_SHIFT+'e' );" ),					// OM - [WHDN] Ejection Seat Safety - ARMED
								TEMPO( bombing_tool,																	// ID - Bombing Tool
									   wingsweep_aft, 500 ),															// 		[long] Wing Sweep Aft
								0 );																					// OD - 
	// CSL
	MapKeyIOUMD(&Throttle, CSL, TEMPO( wingsweep_auto,																	// IU - Wing Sweep Auto Mode
									   wingsweep_fwd, 500 ),															// 		[long] Wing Sweep Forward
								TEMPO( acmcover_toggle,																	// OU - ACM mode toggle
									   fcsstab_roll_toggle, 500 ),														// 		[long] FCS Roll Stabilisation toggle
								TEMPO( wingsweep_auto,																	// IM - Wing Sweep Auto Mode
									   wingsweep_fwd, 500 ),															// 		[long] Wing Sweep Forward
								EXEC( "if (WHDN_mode) ActKey( PULSE+KEYON+R_CTL+L_SHIFT+'p' );" ),						// OM - [WHDN] Parking brake toggle
								TEMPO( wingsweep_auto,																	// IM - Wing Sweep Auto Mode
									   wingsweep_fwd, 500 ),															// 		[long] Wing Sweep Forward
								0 );																					// OD - 


} 	// =====  end of dcs_f14_pilot_controls_switch()  =============================================