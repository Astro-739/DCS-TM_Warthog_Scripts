// JESTER file for DCS_F-14_Tomcat  by Astro
// TARGET version 3.0.25.127
// version 3.0, Sep 2026





// -------------------------------- F-14 JESTER CONTROLS --------------------------------------------

int dcs_f14_jester_controls()
// JESTER controls should stay within JESTER switch set (TMS, DMS, CS, MS)
{

	// -------------------- FLIGHT STICK ----------------------------


	// Target Management Switch
	// H2U
	MapKeyUMD(&AVA_F16, H2U, 	TEMPO( JSTR_lock_tgt_ahead,								 								// U - Radar – STT Lock Target Ahead
									   JSTR_lock_enemy_ahead, 500 ),													// 	   [long] Radar – STT Lock Enemy Ahead
								TEMPO( JSTR_lock_tgt_ahead,								 								// M - Radar – STT Lock Target Ahead
									   JSTR_lock_enemy_ahead, 500 ),													// 	   [long] Radar – STT Lock Enemy Ahead
								JSTR_context );																			// D - Jester Context (Designate / Send coordinates)
	MapKeyR(&AVA_F16, H2U, 		0 );																					// 
	// H2D
	MapKeyUMD(&AVA_F16, H2D, 	TEMPO( JSTR_break_lock,																	// U - Radar – Break Lock
									   0, 500 ),																		// 	   [long] 
								TEMPO( JSTR_break_lock,																	// M - Radar – Break Lock
									   0, 500 ),																		// 	   [long]  
								TEMPO( JSTR_lntrn_undesignate,															// D - LANTIRN - Laser Undesignate
									   JSTR_lntrn_stblarea, 500 ));														//	   [long] LANTIRN - Stabilise Area
	MapKeyR(&AVA_F16, H2D, 		0 );																					// 
	// H2R							
	MapKeyUMD(&AVA_F16, H2R, 	TEMPO( JSTR_context_double, 															// U - Jester Context double
									   JSTR_toggle_RWS_TWS, 500 ),														// 	   [long] Radar – Toggle RWS/TWS Mode
								TEMPO( JSTR_context_double, 															// M - Jester Context double
									   JSTR_toggle_RWS_TWS, 500 ),														// 	   [long] Radar – Toggle RWS/TWS Mode
								TEMPO( JSTR_context_double,  															// D - LANTIRN - Zoom toggle
									   JSTR_lntrn_nexttgt, 500 ));														// 	   [long] LANTIRN - Next Target
	MapKeyR(&AVA_F16, H2R, 		0 );																					// 
	// H2L
	MapKeyUMD(&AVA_F16, H2L, 	TEMPO( 0, 																				// U - 
									   0, 500 ),																		// 	   [long] 
								TEMPO( 0, 																				// M - 
									   0, 500 ),																		// 	   [long] 
								TEMPO( JSTR_lntrn_bwhot_tggl,  															// D - LANTIRN - Black/white hot toggle
									   JSTR_lntrn_prevtgt, 500 ));														// 	   [long] LANTIRN - Previous Target
	MapKeyR(&AVA_F16, H2L, 		0 );																					// 

								
	// Display Management Switch
	// H3U
	MapKey(&AVA_F16, H3U, 		TEMPO( EXEC( "index_range = (index_range+1)%5;"											// Radar range step up
											 "ActKey( KEYON+PULSE+X(radarrangelist, index_range) );" ),					// 
									   0, 500 ));																		// [long]
	// H3D
	MapKey(&AVA_F16, H3D, 		TEMPO( EXEC( "index_range = (index_range+4)%5;"											// Radar range step down
											 "ActKey( KEYON+PULSE+X(radarrangelist, index_range) );" ),					//
									   0, 500 ));																		// [long]
	// H3R
	MapKey(&AVA_F16, H3R, 		TEMPO( JSTR_ground_ac_stbl,																// Radar - Ground/Aircraft Stabilize
									   0, 500 ));																		// [long]
	// H3L
	MapKey(&AVA_F16, H3L, 		TEMPO( CHAIN( JSTR_rdr_range_auto, D(),													// Radar - Range Auto
											  EXEC( "index_range = 2;" )),												// Reset range index to 2 (100 nm) (element 0 is first element in list)
									   JSTR_rdr_mode_auto, 500 ));														// [long] Radar - Mode Auto




	// ----------------------- THROTTLE -----------------------------

	// MIC Switch (Transmit Switch)
	// MSU
	MapKeyUMD(&Throttle, MSU, 	0,																			 			// U - 
								EXEC( "if (WHDN_mode) ActKey( PULSE+KEYON+JSTR_WHDN_startup );" 						// M - [WHDN] JSTR_WHDN_startup
									  "else ActKey( PULSE+KEYON+0 );" ),												//		
								0 );																					// D - 
	// MSD
	MapKeyUMD(&Throttle, MSD, 	TEMPO( 0, 																				// U - 
									   JSTR_jett_droptanks, 500 ),														//	   [long] JSTR_jett_droptanks
								EXEC( "if (WHDN_mode) ActKey( PULSE+KEYON+JSTR_check );" 								// M - [WHDN] JSTR_check
									  "else ActKey( PULSE+KEYON+JSTR_nav_homebase );" ),								//	   JSTR_nav_homebase
								0 );																					// D - 
	// MSR
	MapKeyUMD(&Throttle, MSR, 	JSTR_jammer_onoff,																		// U - JSTR_jammer_onoff
								CHAIN( JSTR_nav_wp1,																	// M - JSTR_nav_wp1
									   EXEC( "index_stpt_aa = 0;" )),													//	   Set steerpoint index to match wp1 (first element is 0)
								JSTR_jammer_onoff );																	// D - JSTR_jammer_onoff
	// MSL
	MapKeyUMD(&Throttle, MSL, 	TEMPO( JSTR_ground_ac_stbl,																// U - Radar - Ground/Aircraft Stabilize
									   JSTR_rdr_offon, 500 ),															//	   [long] JSTR_rdr_offon
								TEMPO( JSTR_ground_ac_stbl,																// M - Radar - Ground/Aircraft Stabilize
									   JSTR_rdr_offon, 500 ),															//	   [long] JSTR_rdr_offon
								TEMPO( JSTR_ground_ac_stbl,																// D - Radar - Ground/Aircraft Stabilize
									   JSTR_rdr_offon, 500 ));															//	   [long] JSTR_rdr_offon
	// MSP 
	MapKey(&Throttle, MSP, 		JSTR_menu );																			// JSTR_menu 



	// Coolie Switch
	// CSU
	MapKeyUMD(&Throttle, CSU, 	JSTR_context,																			// U - 
								JSTR_context,																			// M - 
								JSTR_context );																			// D - 
	// CSD
	MapKeyUMD(&Throttle, CSD, 	JSTR_menu,																				// U - JSTR_menu
								JSTR_menu,																				// M - JSTR_menu
								JSTR_menu );																			// D - JSTR_menu
	// CSR
	MapKeyUMD(&Throttle, CSR, 	EXEC( "index_stpt_aa = (index_stpt_aa+1)%3;"											// U - Next A-A Steerpoint    
									  //"printf(\"index_stpt_aa = %i\\xa\", index_stpt_aa);"							// test
									  "ActKey( KEYON+PULSE+X(steerpointlist_aa, index_stpt_aa) );" ), 					// 
								EXEC( "index_stpt_aa = (index_stpt_aa+1)%3;"											// M - Next A-A Steerpoint    
									  //"printf(\"index_stpt_aa = %i\\xa\", index_stpt_aa);"							// test
									  "ActKey( KEYON+PULSE+X(steerpointlist_aa, index_stpt_aa) );" ), 					// 
								EXEC( "index_stpt_ag = (index_stpt_ag+1)%5;"											// D - Next A-G Steerpoint    
									  "ActKey( KEYON+PULSE+X(steerpointlist_ag, index_stpt_ag) );" ));					// 
	// CSL
	MapKeyUMD(&Throttle, CSL, 	EXEC( "index_stpt_aa = (index_stpt_aa+2)%3;"											// U - Previous A-A Steerpoint    
									  //"printf(\"index_stpt_aa = %i\\xa\", index_stpt_aa);"							// test
									  "ActKey( KEYON+PULSE+X(steerpointlist_aa, index_stpt_aa) );" ), 					// 
								EXEC( "index_stpt_aa = (index_stpt_aa+2)%3;"											// M - Previous A-A Steerpoint    
									  //"printf(\"index_stpt_aa = %i\\xa\", index_stpt_aa);"							// test
									  "ActKey( KEYON+PULSE+X(steerpointlist_aa, index_stpt_aa) );" ), 					// 
								EXEC( "index_stpt_ag = (index_stpt_ag+4)%5;"											// D - Previous A-G Steerpoint
									  "ActKey( KEYON+PULSE+X(steerpointlist_ag, index_stpt_ag) );" )); 					// 



}	// =====  end dcs_f14_jester_controls()  ======================================================

