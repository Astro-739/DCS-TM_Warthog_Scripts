// PILOT file for DCS_F-4E_Phantom.tmc  by Astro
// TARGET version 3.0.25.127
// version 2.3, Sep 2026




// -------------------- PILOT BUTTON DEFINITIONS --------------------------------------------------

int dcs_f4e_pilot_button_definitions()
{

	// Target Management Switch / Armament Selector (overwrites common)
	TMS_fwd 	= pinkyswitch_radar;																					// Gun/Missile Pinky Switch - Radar
						 //DOWN+L_SHIFT, D(10), PULSE+'h', D(), UP+L_SHIFT );												// HUD Mode - A/A
	TMS_aft 	= pinkyswitch_gun;																						// Gun/Missile Pinky Switch - Gun
					  	 //DOWN+L_ALT, D(10), PULSE+'h', D(), UP+L_ALT );													// HUD Mode - Cage
	TMS_right 	= pinkyswitch_heat;																						// Gun/Missile Pinky Switch - Heat
						 //DOWN+L_SHIFT, D(10), PULSE+'h', D(), UP+L_SHIFT );												// HUD Mode - A/A
	TMS_left 	= 0;																									// 

	// Display Management Switch (overwrites common)
	DMS_fwd 	= SEQ( dscgscreen_radar, dscgscreen_tv );																// DSCG Screen Mode - Radar/TV
	DMS_aft 	= 0;																									// DMS aft
	DMS_right 	= rwr_search;																							// RWR Search Button
	DMS_left 	= TEMPO( rwr_prio_open,																					// RWR Mode - Norm/Prio toggle
						 rwr_tgtsep, 500 );																				// RWR Target Separation Button

	// Buttons (overwrite common)
	SC_short	= 0;																									// 
	LDGH_short	= 0;																									// 
	

}	// end dcs_f4e_pilot_button_definitions()	===================================================




// -------------------- PILOT CONTROLS ------------------------------------------------------------

int dcs_f4e_pilot_controls()
{

	// -------------------- COMMON CONTROLS -------------------------
					
	dcs_f4e_pilot_button_definitions();					// load button definitions used by COMMON
	dcs_fighter_common_controls();						// load dcs COMMON controls
	dcs_fighter_common_mfd();							// load dcs MFD controls
														// before aircraft controls, to allow for overwriting of common controls when necessary


	// ----------------------- LEFT MFD -----------------------------

	MapKeyIO(&LMFD, OSB03, 		CHAIN( DOWN+R_WIN+R_SHIFT, D(10), PULSE+'3', D(), UP+R_WIN+R_SHIFT ), 					// I - Right MFD OSB 03
								TEMPO( CHAIN( DOWN+R_WIN+L_SHIFT, D(10), PULSE+'3', D(), UP+R_WIN+L_SHIFT ),			// O - Left MFD OSB 03
									   CHAIN( DOWN+R_WIN+L_SHIFT, D(10), PULSE+'p', D(), UP+R_WIN+L_SHIFT ), 500 ));	//     [long] Left MFD OSB 03 - Arm Gun


	// -------------------- FLIGHT STICK ----------------------------

	// -- DCS_Fighter_Common ---------
	// TG - Gun Trigger
	// S1 - Nosewheel Steering Button
	// H1 - Trim Switch
	// H2 - Target Management Switch
	// DMS - Display Management Switch (in specific control section at end of file)
	// JOYX
	// JOYY
	// -------------------------------


	// JSTR layer
	// Expand FOV Button - S3
	MapKey(&AVA_F16, S3,  		EXEC( "if(LTRN_mode) dcs_f4e_jester_lantirn_controls();"								// Switch to JESTER LANTIRN controls (LTRN_mode ON)
									  "else dcs_f4e_jester_controls();" ));												// Switch to JESTER controls (LTRN_mode OFF)
	MapKeyR(&AVA_F16, S3,  		EXEC( "dcs_fighter_common_switch();" 													// Switch back to COMMON,
									  "dcs_f4e_pilot_controls_switch();" ));											//   and PILOT controls

	// -------------------------------


 	// Countermeasure Management Switch
	// H4U	
	MapKeyIO(&AVA_F16, H4U, 	0,																						// I - 
							 	cm_dispprog_flares );																	// O - Dispense Program - Flares
	// H4D
	MapKeyIO(&AVA_F16, H4D, 	0,																						// I - 
							 	cm_dispprog_norm );																		// O - Dispense Program - Normal
	// H4R
	MapKeyIO(&AVA_F16, H4R, 	0,																						// I - 
			  				 	0 );																					// O - 
	// H4L
	MapKeyIO(&AVA_F16, H4L, 	0,									 													// I - 
							 	0 ); 																					// O - 
	// H4P
	MapKeyIO(&AVA_F16, H4P, 	0, 																						// I - 
							 	cm_dispense ); 																			// O - Countermeasure Dispense

	
	
 
	// -------------------- THROTTLE --------------------------------

	// --DCS_Fighter_Common---------
	// Left Throttle Button
	// SPDF/B
	// CHF/B
	// MSU/D/P
	// PSF/B
	// EACON/OFF Landing Gear
	// EOLIGN/OVER
	// EORIGN/OVER
	// EFLNORM/OVER
	// EFRNORM/OVER
	// SC
	// APUON/OFF
	// RDRNRM/DIS Canopy
	// IDLELON/IDLERON
	// THR_LEFT
	// THR_RIGHT
	// THR_FC
	// SCX
	// SCY
	// -----------------------------



	// Autopilot
	// APENG	
	MapKeyIO(&Throttle, APENG, 	0,																					// I - 
								autopilot );																		// O - Autopilot/AFCS on/off
	// APDIS
	MapKey(&Throttle, APDIS, 	0 ); 																				// 
	// APPAT
	MapKey(&Throttle, APPAT, 	CHAIN( DOWN+L_ALT+L_SHIFT, D(10), PULSE+'h', D(), UP+L_ALT+L_SHIFT ));				// ALT Hold - Engage
	// APAH
	MapKey(&Throttle, APAH, 	CHAIN( DOWN+L_ALT+L_CTL, D(10), PULSE+'h', D(), UP+L_ALT+L_CTL ));					// ALT Hold - Disengage
	// APALT
	MapKey(&Throttle, APALT, 	CHAIN( DOWN+L_ALT+L_CTL, D(10), PULSE+'h', D(), UP+L_ALT+L_CTL ));					// ALT Hold - Disengage



	// Pinky Switch (exterior lighting)
	// PSF
	MapKeyIO(&Throttle, PSF, 	CHAIN( extlight_flashsteady, D(), 													// I - extlight_flashsteady
									   LED(&Throttle, LED_ONOFF, LED_CURRENT+LED4) ), 								//     LED4 ON
							 	CHAIN( extlight_full, D(), 															// O - extlight_full
									   LED(&Throttle, LED_ONOFF, LED_CURRENT+LED4) )); 								//     LED4 ON
	MapKeyRIO(&Throttle, PSF, 	CHAIN( 0, D(), 																		// I - 
									   LED(&Throttle, LED_ONOFF, LED_CURRENT-LED4) ),								//     LED4 OFF
							  	CHAIN( extlight_position, D(), 														// O - extlight_position
									   LED(&Throttle, LED_ONOFF, LED_CURRENT-LED4) )); 								//     LED4 OFF
	// PSB		
	MapKeyIO(&Throttle, PSB, 	CHAIN( extlight_posdim, D(), 														// I - extlight_posdim
									   LED(&Throttle, LED_ONOFF, LED_CURRENT+LED4) ), 								//     LED4 ON
							 	CHAIN( extlight_covert, D(), 														// O - extlight_covert
									   LED(&Throttle, LED_ONOFF, LED_CURRENT+LED4) )); 								//     LED4 ON
	MapKeyRIO(&Throttle, PSB, 	CHAIN( 0, D(), 																		// I - 
									   LED(&Throttle, LED_ONOFF, LED_CURRENT-LED4) ),								//     LED4 OFF
							  	CHAIN( extlight_position, D(), 														// O - extlight_position
									   LED(&Throttle, LED_ONOFF, LED_CURRENT-LED4) )); 								//     LED4 OFF


	// Flaps Switch
	// FLAPU
	MapKey(&Throttle, FLAPU,  	CHAIN( D(300), flapsslats_norm ));													// Flaps/Slats Switch - Norm
	// FLAPM
	MapKey(&Throttle, FLAPM, 	flapsslats_out );																	// Flaps/Slats Switch - Out
	// FLAPD	
	MapKey(&Throttle, FLAPD,  	CHAIN( D(300), flapsslats_outdown ));												// Flaps/Slats Switch - Out&Down


	// Engine Operation
	// EOLIGN
	MapKeyIO(&Throttle, EOLIGN,	0,																					// I - 
								CHAIN( engine_ignition_left, D(300),												// O - Left Engine Ignition
									   throttle_left_idle ));														// 	   Throttle Left - IDLE
	// EORIGN
	MapKeyIO(&Throttle, EORIGN, 0,																					// I - 
								CHAIN( engine_ignition_right, D(300), 												// O - Right Engine Ignition
									   throttle_right_idle ));														// 	   Throttle Right - IDLE

	// Engine Override
	// EFL in Phantom main script


	// U LAYER - [O] Air-to-Air Mode
	//			 [I] ACM Mode
	// BSF - LED1 ON/OFF
	MapKeyIO(&Throttle, BSF, 	CHAIN( hudmode_a2a, D(200),																// I - HUD Mode - A/A
									   DOWN+'c', D(200), UP+'c', D(200),												// 	   Cage Button
									   DOWN+R_CTL+L_CTL, D(10), PULSE+'r', D(), UP+R_CTL+L_CTL, D(),					//	   STAB AUG Roll - Disengage
									   LED(&Throttle, LED_ONOFF, LED_CURRENT+LED1) ), 									// 	   LED1 ON for U layer
								CHAIN( DOWN+L_SHIFT, D(10), PULSE+'h', D(), UP+L_SHIFT, D(200),							// O - HUD Mode - A/A
									   DOWN+R_CTL+L_CTL, D(10), PULSE+'r', D(), UP+R_CTL+L_CTL, D(),					//	   STAB AUG Roll - Disengage
									   LED(&Throttle, LED_ONOFF, LED_CURRENT+LED1) )); 									// 	   LED1 ON for U layer
	MapKeyRIO(&Throttle, BSF, 	CHAIN( hudmode_cage, D(200),															// I - HUD Mode - Cage
									   DOWN+R_CTL+L_SHIFT, D(10), PULSE+'r', D(), UP+R_CTL+L_SHIFT, D(),				//	   STAB AUG Roll - Engage
									   LED(&Throttle, LED_ONOFF, LED_CURRENT-LED1) ), 									// 	   LED1 OFF for U layer 
								CHAIN( hudmode_cage, D(200),															// O - HUD Mode - Cage
									   DOWN+R_CTL+L_SHIFT, D(10), PULSE+'r', D(), UP+R_CTL+L_SHIFT, D(),				//	   STAB AUG Roll - Engage
									   LED(&Throttle, LED_ONOFF, LED_CURRENT-LED1) )); 									// 	   LED1 OFF for U layer

	// M LAYER - Navigation Mode
	// BSM - LED2 ON/OFF
	MapKey(&Throttle, BSM, 		LED(&Throttle, LED_ONOFF, LED_CURRENT+LED2)); 											// LED2 ON for M layer
	MapKeyR(&Throttle, BSM, 	LED(&Throttle, LED_ONOFF, LED_CURRENT-LED2)); 											// LED2 OFF for M layer

	// D LAYER - Air-to-Ground Mode
	// BSB - LED3 ON/OFF
	MapKeyIO(&Throttle, BSB, 	CHAIN( EXEC( "Throttle[BSB] = 0; DefEventHandler(EV_HID_INPUT_DATA, &Throttle, BSB);"),	// I - Temporary virtual M layer (reset D layer)
									   EXEC( "CAR_mode = 1;"															// 	   Set CAR_mode ON
											 "printf(\"CAR_mode = 1\\xa\");" ),											// 
									   LED(&Throttle, LED_ONOFF, LED_CURRENT+LED5) ),									//     LED5 ON
								CHAIN( hudmode_a2g, D(),																// O - HUD Mode - A/G
									   LED(&Throttle, LED_ONOFF, LED_CURRENT+LED3) )); 									//     A-G mode on, LED3 ON for D layer
	MapKeyRIO(&Throttle, BSB, 	CHAIN( EXEC( "CAR_mode = 0;"															// I - Set CAR_mode OFF
											 "printf(\"CAR_mode = 0\\xa\");" ),											// 
									   LED(&Throttle, LED_ONOFF, LED_CURRENT-LED5) ),									//     LED5 OFF
								CHAIN( hudmode_cage, D(),																// O - HUD Mode - Cage
									   LED(&Throttle, LED_ONOFF, LED_CURRENT-LED3) ));									// 	   A-G mode off, LED3 OFF for D layer

	



	
	// ----------- Also load SWITCH part of PILOT controls ----------
	
	dcs_f4e_pilot_controls_switch();																					// controls to be switched back after JESTER use


}	// end dcs_f4e_pilot_controls()	===============================================================




// ----------------- PILOT SWITCH CONTROLS to be switched back after JESTER use -------------------

int dcs_f4e_pilot_controls_switch()
{

	// -------------------- COMMON SWITCH CONTROLS ------------------

	dcs_f4e_pilot_button_definitions();					// load button definitions used by COMMON
	dcs_fighter_common_switch();						// switch back to common controls


	// ------------------ AIRCRAFT SWITCH CONTROLS ------------------

	// Coolie Switch
	// CSU
	MapKeyIOUMD(&Throttle, CSU, CHAIN( L_SHIFT, D(10), '-'),										 					// IU - Aural Tone Volume - [Dec]
								0,																						// OU - 
								seat_up,																  				// IM - Seat Position - Up
								reticle_depr_decr,																		// OM - Reticle Depression - [Dec]
								CHAIN( L_SHIFT, D(10), '-'),										 					// ID - Aural Tone Volume - [Dec]
								reticle_depr_decr ); 																	// OD - Reticle Depression - [Dec]
	// CSD
	MapKeyIOUMD(&Throttle, CSD, CHAIN( L_SHIFT, D(10), '='),										 					// IU - Aural Tone Volume - [Inc]
								0,																						// OU -
								seat_down,																  				// IM - Seat Position - Down
								reticle_depr_incr,													 					// OM - Reticle Depression - [Inc]
								CHAIN( L_SHIFT, D(10), '='),										 					// ID - Aural Tone Volume - [Inc]
								reticle_depr_incr );												 					// OD - Reticle Depression - [Inc]
	// CSR
	MapKeyIOUMD(&Throttle, CSR, 0,																						// IU - 
								uncage,			// TODO check refuel													// OU - Air Refuel Release Button (ARR) - missile uncage
								bombing_table,																			// IM - Bombing Table - [Toggle]
								uncage, 																				// OM - Air Refuel Release Button (ARR)
								bombing_table,																			// ID - Bombing Table - [Toggle]
								0 );																					// OD - 
	// CSL
	MapKeyIOUMD(&Throttle, CSL, SEQ( hudmode_a2a, hudmode_cage ),														// IU - HUD Mode – A/A Cage toggle
								cagebutton,																				// OU - Cage Button     was: CHAIN( DOWN+'c', D(200), UP+'c' )
								0,																						// IM - 
								0,																						// OM - 
								SEQ( hudmode_a2g, hudmode_cage ),														// ID - HUD Mode – A/G Cage toggle
								cagebutton );																			// OD - Cage Button     was: CHAIN( DOWN+'c', D(200), UP+'c' )


} 	// end of dcs_f4e_pilot_controls_switch()	===================================================